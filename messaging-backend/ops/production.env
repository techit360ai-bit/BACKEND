# =============================================================================
# TechIT messaging (Go) — production env template for the AWS EC2 host.
#
# COMMITTED, secret-free. Applied to `messaging-backend/.env` by the deploy
# workflow via ops/ec2/sync-env.mjs. Secrets are injected from GitHub Actions:
#   DATABASE_URL  REDIS_URL  JWT_PUBLIC_KEY  JWT_SECRET (copied from backend)
#
# The messaging service uses its OWN database on the shared RDS instance
# (`techit_msg`). It must NOT point at `techit_db`: its `users` table collides
# with the ai-router schema that lives there.
# =============================================================================

ENVIRONMENT=production
PORT=8080

# Shared platform token contract (RS256). JWT_SECRET is retained for the
# dev/test HS256 path only; production verification uses JWT_PUBLIC_KEY.
JWT_ISSUER=techit-backend
JWT_AUDIENCE=techit-platform
JWT_SECRET=
JWT_PUBLIC_KEY=

# Durable state + realtime fanout.
DATABASE_URL=
REDIS_URL=

# Recommendation & Discovery Intelligence Engine.
DISCOVERY_API_URL=https://backend.techitnetwork.com

# Browser origins allowed for REST and WebSocket traffic.
CORS_ORIGINS=https://beta.techitnetwork.com

# Must stay disabled in production (config.Load refuses to boot otherwise).
ENABLE_DEV_TOKEN=0

# Optional LiveKit audio/video (must match the backend values).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
