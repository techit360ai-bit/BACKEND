# Go messaging/feed service.
ENVIRONMENT=production
PORT=8080

# Must match BACKEND/backend and ai-router.
JWT_SECRET=replace-with-64-hex-character-shared-platform-secret
# PEM RSA public key matching the platform RS256 signing key (required in
# production/staging; the platform never signs with JWT_SECRET there).
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-platform-rs256-public-key\n-----END PUBLIC KEY-----"
JWT_ISSUER=techit-backend
JWT_AUDIENCE=techit-platform

# Durable messaging state and realtime fanout.
DATABASE_URL=postgres://techit:replace-me@postgres.example.com:5432/techit_msg?sslmode=require
REDIS_URL=rediss://redis.example.com:6379

# Shared Recommendation & Discovery Intelligence Engine.
DISCOVERY_API_URL=https://api.example.com

# Browser origin allowed for REST and WebSocket traffic.
CORS_ORIGINS=https://beta.techitnetwork.com

# Optional build identity for /health and /ready (set by the deploy workflow).
# GIT_SHA=replace-with-commit-sha
# BUILD_TIME=replace-with-iso-timestamp

# Must stay disabled in production.
ENABLE_DEV_TOKEN=0

# Optional LiveKit integration. If one value is set, set all three.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
