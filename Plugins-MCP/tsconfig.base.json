{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "declaration": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@techit/core": ["packages/core/src/index.ts"],
      "@techit/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@techit/mcp-client": ["packages/mcp-client/src/index.ts"],
      "@techit/infra-secrets": ["infra/secrets/src/index.ts"],
      "@techit/infra-audit": ["infra/audit/src/index.ts"],
      "@techit/infra-auth": ["infra/auth/src/index.ts"],
      "@techit/plugin-github": ["plugins/github/index.ts"]
    }
  }
}
