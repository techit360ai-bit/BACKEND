# Plugins-MCP runs mounted inside BACKEND/backend at /api/mcp.
NODE_ENV=production
JWT_SECRET=replace-with-64-hex-character-shared-platform-secret

# Durable audit, approvals, and contribution feed state.
MCP_DATA_FILE=/var/lib/techit/plugins-mcp.json

# Production must keep the mounted MCP surface disabled until a transactional
# shared store and real connectors replace these development implementations.
MCP_ENABLED=false
MCP_ALLOW_FILE_STORE=false
MCP_ALLOW_STUB_CONNECTORS=false
MCP_SEED_DEMO_ACTIVITY=false
MCP_APPROVAL_TTL_MS=900000
