# Plugins-MCP runs mounted inside BACKEND/backend at /api/mcp.
NODE_ENV=production
JWT_SECRET=replace-with-64-hex-character-shared-platform-secret

# Durable audit, approvals, and contribution feed state.
MCP_DATA_FILE=/var/lib/techit/plugins-mcp.json

# Explicit production acknowledgements for the current single-replica demo mode.
MCP_ALLOW_FILE_STORE=true
MCP_ALLOW_STUB_CONNECTORS=true
MCP_APPROVAL_TTL_MS=900000
