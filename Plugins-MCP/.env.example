# Plugins-MCP runs mounted inside BACKEND/backend at /api/mcp.
NODE_ENV=production
JWT_SECRET=replace-with-64-hex-character-shared-platform-secret

# Durable audit, approvals, and contribution feed state.
MCP_DATA_FILE=/tmp/techit/plugins-mcp.json

# Production MCP: explicit opt-in, shared PostgreSQL, encrypted durable secrets.
MCP_ENABLED=true
MCP_STORE=postgres
MCP_DATABASE_URL=postgresql://mcp_app:replace@postgres.example:5432/techit_mcp?sslmode=require
MCP_DATABASE_SSL=true
MCP_DATABASE_SSL_REJECT_UNAUTHORIZED=true
MCP_SECRET_KEY=replace_with_base64_encoded_32_byte_key
MCP_SECRET_KEY_PREVIOUS=
MCP_ENABLED_CONNECTORS=github,notion,figma,web3
MCP_ALLOW_FILE_STORE=false
MCP_ALLOW_STUB_CONNECTORS=false
MCP_SEED_DEMO_ACTIVITY=false
MCP_APPROVAL_TTL_MS=900000

GITHUB_CONNECTOR_MODE=real
MCP_GITHUB_TOKEN=replace
NOTION_CONNECTOR_MODE=real
NOTION_TOKEN=replace
FIGMA_CONNECTOR_MODE=real
FIGMA_TOKEN=replace
WEB3_CONNECTOR_MODE=real
WEB3_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SIWE_EXPECTED_DOMAIN=app.example.com
SIWE_EXPECTED_URI=https://app.example.com
SIWE_EXPECTED_CHAIN_ID=11155111
SIWE_MAX_AGE_MS=600000
