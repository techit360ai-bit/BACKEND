# Node/Express API and mounted Plugins-MCP surface.
NODE_ENV=production
PORT=3000

# Shared with ai-router, Plugins-MCP auth, and messaging-backend.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=replace-with-pem-private-key
JWT_PUBLIC_KEY=replace-with-pem-public-key
JWT_SECRET=replace-with-64-hex-character-development-only-secret
JWT_ISSUER=techit-backend
JWT_AUDIENCE=techit-platform
OTP_HASH_SECRET=replace-with-a-separate-64-character-otp-hmac-secret

# Browser CORS and links generated by password reset emails.
# Deployed SPA origin. The AWS runtime value is applied separately; /ready
# fails closed if this is unset or non-https in production.
CORS_ORIGINS=https://beta.techitnetwork.com
FRONTEND_URL=https://app.example.com
TRUST_PROXY_HOPS=1

# PostgreSQL is the production request authority. SQLite is development-only
# and is not permitted by production configuration validation.
DB_DRIVER=postgres
PLATFORM_REQUEST_AUTHORITY=postgres
PLATFORM_AUTHORITY_FALLBACK_SQLITE=false
# Set these only while running the one-time backfill/verification against a
# retained legacy SQLite volume.
LEGACY_DB_DRIVER=sqlite
SQLITE_DB_PATH=/var/lib/techit/backend/techit.sqlite
# Keep single-node until live PostgreSQL concurrency, failover, and rollback
# drills pass; multi-replica additionally requires shared Redis coordination.
SCALE_PROFILE=single-node
REQUIRE_SHARED_STATE=false
GLOBAL_RATE_LIMIT_REDIS=true
GLOBAL_API_REQUESTS_PER_MINUTE=600
GLOBAL_AUTH_REQUESTS_PER_MINUTE=600
AI_ROUTER_MAX_IN_FLIGHT=64
AI_ROUTER_MAX_QUEUE=256
TRUST_DATABASE_URL=postgresql://trust_app:replace@postgres.example:5432/techit_trust?sslmode=require
IDENTITY_DATABASE_URL=postgresql://core_app:replace@postgres.example:5432/techit_core?sslmode=require
IDENTITY_DB_POOL_SIZE=5
IDENTITY_PROJECTION_INTERVAL_MS=30000
IDENTITY_SHADOW_READS=false
IDENTITY_SHADOW_READ_REQUIRED=false
IDENTITY_READ_SOURCE=sqlite
IDENTITY_READ_FALLBACK_SQLITE=true
IDENTITY_READ_POOL_SIZE=5
IDENTITY_WRITE_SOURCE=sqlite
IDENTITY_WRITE_FALLBACK_SQLITE=true
IDENTITY_WRITE_POOL_SIZE=5
# Access-token session claims (active context + active subscription) follow the
# same authority as the identity bundle: with IDENTITY_READ_SOURCE or
# IDENTITY_WRITE_SOURCE=postgres they are read row-level instead of from the
# whole-DB snapshot. IDENTITY_READ_FALLBACK_SQLITE=true keeps the snapshot
# claims as the fallback on a PostgreSQL read failure.
MIGRATION_OUTBOX_BATCH_SIZE=100
WORKSPACE_DATABASE_URL=postgresql://core_app:replace@postgres.example:5432/techit_core?sslmode=require
WORKSPACE_DB_POOL_SIZE=5
WORKSPACE_READ_SOURCE=sqlite
WORKSPACE_READ_FALLBACK_SQLITE=true
WORKSPACE_READ_POOL_SIZE=5
WORKSPACE_WRITE_SOURCE=sqlite
WORKSPACE_WRITE_FALLBACK_SQLITE=true
WORKSPACE_CODE_SOURCE=sqlite
WORKSPACE_CODE_FALLBACK_SQLITE=true
WORKSPACE_PROJECTION_INTERVAL_MS=30000
CONTENT_DATABASE_URL=postgresql://core_app:replace@postgres.example:5432/techit_core?sslmode=require
CONTENT_DB_POOL_SIZE=5
CONTENT_READ_SOURCE=sqlite
CONTENT_READ_FALLBACK_SQLITE=true
CONTENT_READ_POOL_SIZE=5
CONTENT_WRITE_SOURCE=sqlite
CONTENT_WRITE_FALLBACK_SQLITE=true
CONTENT_WRITE_POOL_SIZE=5
CONTENT_PROJECTION_INTERVAL_MS=30000
INVESTOR_DATABASE_URL=postgresql://core_app:replace@postgres.example:5432/techit_core?sslmode=require
INVESTOR_DB_POOL_SIZE=5
INVESTOR_READ_SOURCE=sqlite
INVESTOR_READ_FALLBACK_SQLITE=true
INVESTOR_WRITE_SOURCE=sqlite
INVESTOR_WRITE_FALLBACK_SQLITE=true
# Row-level investor deal-room authority (WS0 §5). The deal-room services run
# against a bounded platform snapshot (deals + children) instead of the whole-DB
# snapshot, persist changed rows and refresh the investor_* projection once this
# is postgres.
INVESTOR_SOURCE=sqlite
INVESTOR_FALLBACK_SQLITE=true
ORGANIZATION_DATABASE_URL=postgresql://core_app:replace@postgres.example:5432/techit_core?sslmode=require
ORGANIZATION_DB_POOL_SIZE=5
ORGANIZATION_READ_SOURCE=sqlite
ORGANIZATION_READ_FALLBACK_SQLITE=true
ORGANIZATION_WRITE_SOURCE=sqlite
ORGANIZATION_WRITE_FALLBACK_SQLITE=true
# Row-level organization access + program authority (WS0 §5). The permission
# gate (active context, membership, legacy ownership) and sponsorship/managed
# hackathon records resolve bounded rows instead of the whole-DB snapshot once
# this is postgres.
ORGANIZATION_SOURCE=sqlite
ORGANIZATION_FALLBACK_SQLITE=true
FINANCE_READ_SOURCE=sqlite
FINANCE_READ_FALLBACK_SQLITE=true
FINANCE_READ_POOL_SIZE=5
FINANCE_WRITE_SOURCE=sqlite
BILLING_JOBS_ENABLED=false
BILLING_JOBS_INTERVAL_MS=3600000
FINANCE_WRITE_FALLBACK_SQLITE=true
CUTOVER_MONITOR_ENABLED=true
FINANCE_DATABASE_URL=postgresql://core_app:replace@postgres.example:5432/techit_core?sslmode=require
FINANCE_DB_POOL_SIZE=5
FINANCE_PROJECTION_INTERVAL_MS=30000
PLATFORM_DATABASE_URL=postgresql://core_app:replace@postgres.example:5432/techit_core?sslmode=require
PLATFORM_DB_POOL_SIZE=10
PLATFORM_DB_CONNECTION_TIMEOUT_MS=5000
PLATFORM_DB_SSL_REJECT_UNAUTHORIZED=true
PLATFORM_REQUEST_AUTHORITY=sqlite
PLATFORM_AUTHORITY_FALLBACK_SQLITE=true
POSTGRES_AUTHORITY_MODE=shadow
INTELLIGENCE_SOURCE=sqlite
INTELLIGENCE_READ_SOURCE=sqlite
INTELLIGENCE_WRITE_SOURCE=sqlite
INTELLIGENCE_FALLBACK_SQLITE=true
OPERATIONAL_SOURCE=sqlite
OPERATIONAL_READ_SOURCE=sqlite
OPERATIONAL_WRITE_SOURCE=sqlite
OPERATIONAL_FALLBACK_SQLITE=true
# Row-level authorization / role-context authority (WS0 §5). Capability
# decisions and role/context switches resolve owner-scoped rows instead of the
# whole-DB snapshot once this (or an authoritative identity source) is
# postgres. Keep sqlite until the backfill + rollback drills pass.
AUTHORIZATION_SOURCE=sqlite
AUTHORIZATION_FALLBACK_SQLITE=true
# Row-level TechIT Academy authority (WS0 §5). Curriculum + learner evidence
# resolve owner-scoped rows and the referenced project evidence instead of the
# whole-DB snapshot once this is postgres.
ACADEMY_SOURCE=sqlite
ACADEMY_FALLBACK_SQLITE=true
# Row-level mentorship authority (WS0 §5). Rooms and their room-scoped children
# resolve owned/published/room rows instead of the whole-DB snapshot once this
# is postgres.
MENTORSHIP_SOURCE=sqlite
MENTORSHIP_FALLBACK_SQLITE=true
TRUST_DB_SSL_REJECT_UNAUTHORIZED=true
TRUST_DB_POOL_SIZE=5
TRUST_PROJECTION_INTERVAL_MS=30000
# Row-level trust authority (WS0). Keep on sqlite/legacy until the backfill,
# verify, and rollback drills pass, then flip read first, soak, then write.
TRUST_READ_SOURCE=sqlite
TRUST_READ_FALLBACK_SQLITE=true
TRUST_WRITE_SOURCE=sqlite
TRUST_WRITE_FALLBACK_SQLITE=true
# Scoring policy. trust-v3 is proposed and inert until product signs off.
TRUST_POLICY_VERSION=trust-v2
TRUST_POLICY_V3_SIGNED_OFF=false
# Trust adapter plumbing (WS1). The AI-router normalizes provider metadata; the
# Node backend is the only authority that persists proofs.
AI_ROUTER_TRUST_SECRET=
AI_ROUTER_TRUST_SERVICE_ID=platform-backend
TRUST_ADAPTER_TIMEOUT_MS=8000
# Secret for the service-authenticated adapter ingest route used by verification
# workers. Leave empty to keep the route disabled (fails closed).
TRUST_INGEST_SECRET=
# Execution source availability. All default OFF, so the founder UI shows
# "Coming soon" until credentials + DPIA are in place.
TRUST_CONTACT_SOURCES_ENABLED=false
TRUST_REVENUE_ENABLED=false
TRUST_PRODUCT_ANALYTICS_ENABLED=false
TRUST_SHIPPING_ENABLED=false
TRUST_TEAM_ENABLED=false
TRUST_OUTCOMES_ENABLED=false
TRUST_IDENTITY_ENABLED=false
# Scoring policy overrides (WS2). Optional; invalid values are ignored and
# reported as warnings so a typo cannot weaken scoring. Caps use
# TRUST_CAP_<SOURCE>; half-lives use TRUST_HALFLIFE_<SOURCE>.
TRUST_CAP_IDENTITY=18
TRUST_CAP_REVENUE=15
TRUST_HALFLIFE_REVENUE=30
TRUST_ATTESTATION_SELF_WEIGHT=0.35
TRUST_TIER_HIGHLY_TRUSTED=80
TRUST_TIER_VERIFIED=60
TRUST_TIER_BUILDING=30
# Anti-gaming thresholds (WS2). All env-configurable with safe code defaults.
TRUST_VELOCITY_MAX_PROOFS_PER_HOUR=12
TRUST_VELOCITY_MAX_SUBMITS_PER_DAY=40
TRUST_ANOMALY_BURST_WINDOW_MINUTES=10
TRUST_ANOMALY_BURST_MAX_PROOFS=6
TRUST_EVIDENCE_REUSE_WINDOW_DAYS=3650
TRUST_EVIDENCE_REUSE_STRICT=false
TRUST_CONSISTENCY_STRICT=false

# Revenue verification (WS3). Credentials are read from the SAME env vars the
# payment gateway uses (STRIPE_SECRET_KEY / PAYSTACK_SECRET_KEY /
# FLUTTERWAVE_SECRET_KEY); founders may also connect their own read-only key,
# which is encrypted at rest with TRUST_CREDENTIAL_ENCRYPTION_KEY.
TRUST_CREDENTIAL_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
PADDLE_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Comma list of enabled sub-providers (code default: stripe).
TRUST_REVENUE_PROVIDERS=stripe
# DPIA gate: while unapproved, revenue stays "coming soon" in the founder UI.
TRUST_REVENUE_REQUIRE_DPIA=false
TRUST_REVENUE_DPIA_APPROVAL_REF=
# Anti-fraud + refresh knobs (all optional; safe defaults in code).
TRUST_REVENUE_REQUIRE_LIVEMODE=true
TRUST_REVENUE_REQUIRE_DOMAIN_MATCH=false
TRUST_REVENUE_ALLOW_SECRET_KEYS=false
TRUST_REVENUE_MIN_MRR=0
TRUST_REVENUE_MIN_PAYING_CUSTOMERS=0
TRUST_REVENUE_MAX_MRR_JUMP_PCT=500
TRUST_REVENUE_MAX_RECORDS=5000
TRUST_REVENUE_TIMEOUT_MS=15000
TRUST_REVENUE_SYNC_INTERVAL_MS=86400000
TRUST_REVENUE_PROOF_TTL_DAYS=30
# Enable the 24h refresh worker on exactly one replica.
TRUST_REVENUE_REFRESH_ENABLED=false

# Product analytics verification (WS4). Read-only analytics credentials; the
# canonical subject (project/property id) is stored with the encrypted key.
TRUST_ANALYTICS_ENABLED=false
TRUST_ANALYTICS_PROVIDERS=posthog
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://app.posthog.com
GA4_ACCESS_TOKEN=
GA4_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROPERTY_ID=
MIXPANEL_SECRET=
MIXPANEL_PROJECT_ID=
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# DPIA gate + anti-fraud + refresh knobs (optional; safe defaults in code).
TRUST_ANALYTICS_REQUIRE_DPIA=false
TRUST_ANALYTICS_DPIA_APPROVAL_REF=
TRUST_ANALYTICS_REQUIRE_DOMAIN_MATCH=false
TRUST_ANALYTICS_MIN_MAU=0
TRUST_ANALYTICS_MAX_MAU_JUMP_RATIO=5
TRUST_ANALYTICS_MAX_FRESHNESS_HOURS=72
TRUST_ANALYTICS_WINDOW_DAYS=30
TRUST_ANALYTICS_PROOF_TTL_DAYS=7
TRUST_ANALYTICS_SYNC_INTERVAL_MS=86400000
TRUST_ANALYTICS_TIMEOUT_MS=15000
TRUST_ANALYTICS_REFRESH_ENABLED=false

# Universal Discovery normalized projection, vector search, cache and worker.
DISCOVERY_DATABASE_URL=postgresql://discovery_app:replace@postgres.example:5432/techit_discovery?sslmode=require
DISCOVERY_REDIS_URL=rediss://redis.example.com:6379
DISCOVERY_DB_POOL_SIZE=10
# Base TTL for the general feed; people/opportunities use the per-surface values below.
DISCOVERY_CACHE_TTL_SECONDS=300
# People you may know: shorter TTL, invalidated on follow/connect/profile change.
DISCOVERY_PEOPLE_TTL_SECONDS=600
# Opportunities: longer TTL, invalidated on a new opportunity/post.
DISCOVERY_OPPORTUNITY_TTL_SECONDS=3600
DISCOVERY_FULL_REFRESH_MS=900000

# Email delivery for OTP and password reset flows.
RESEND_API_KEY=re_replace_me
WHATSAPP_NOTIFICATION_URL=
WHATSAPP_NOTIFICATION_SECRET=
FROM_EMAIL=TechIT <noreply@example.com>

# Plugins-MCP production storage and encrypted connector credentials.
MCP_ENABLED=true
MCP_STORE=postgres
MCP_DATABASE_URL=postgresql://mcp_app:replace@postgres.example:5432/techit_mcp?sslmode=require
MCP_DATABASE_SSL=true
MCP_DATABASE_SSL_REJECT_UNAUTHORIZED=true
MCP_SECRET_KEY=replace_with_base64_encoded_32_byte_key
MCP_SECRET_KEY_PREVIOUS=
MCP_ENABLED_CONNECTORS=github,notion,figma,web3
MCP_DATA_FILE=/tmp/techit/plugins-mcp.json
MCP_ALLOW_FILE_STORE=false
MCP_ALLOW_STUB_CONNECTORS=false
MCP_SEED_DEMO_ACTIVITY=false
MCP_APPROVAL_TTL_MS=900000
GITHUB_CONNECTOR_MODE=real
MCP_GITHUB_TOKEN=replace-with-production-github-app-token
NOTION_CONNECTOR_MODE=real
NOTION_TOKEN=replace-with-production-notion-token
FIGMA_CONNECTOR_MODE=real
FIGMA_TOKEN=replace-with-production-figma-token
WEB3_CONNECTOR_MODE=real
WEB3_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SIWE_EXPECTED_DOMAIN=app.example.com
SIWE_EXPECTED_URI=https://app.example.com
SIWE_EXPECTED_CHAIN_ID=11155111
SIWE_MAX_AGE_MS=600000

# GitHub OAuth (register at https://github.com/settings/developers)
# Test credentials work in local mode — replace for production.
GITHUB_CLIENT_ID=replace-with-production-github-client-id
GITHUB_CLIENT_SECRET=replace-with-production-github-client-secret
GITHUB_REDIRECT_URI=https://api.example.com/api/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-character-encryption-key

# Video CDN (use test URL locally, replace with Cloudflare/S3 CDN in production)
VIDEO_CDN_BASE=https://test-cdn.techit.dev/videos

# LiveKit audio/video calls. Must match the messaging service (BACKEND/
# messaging-backend LIVEKIT_API_KEY/API_SECRET/URL). When blank, workspace calls
# report an explicit "not configured" state instead of a fake call surface.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Admin dashboard initial super admin (auto-created on first login attempt)
# Optional one-time bootstrap. Do not use defaults; remove these after the
# first super-admin is created and rotate the password immediately.
ADMIN_SUPER_EMAIL=
ADMIN_SUPER_PASSWORD=

# Backend-owned AI usage reservation and settlement contract.
AI_ROUTER_SETTLEMENT_SECRET=replace-with-64-hex-character-service-secret
ADMIN_AI_ROUTER_TELEMETRY_SECRET=replace-with-a-dedicated-64-character-admin-telemetry-secret
ADMIN_AI_ROUTER_TELEMETRY_SERVICE_ID=platform-backend
AI_ROUTER_SERVICE_ID=ai-router
AI_ROUTER_SETTLEMENT_MAX_SKEW_SECONDS=300
AI_USAGE_GRANT_SERVICE_ID=platform-backend
AI_USAGE_GRANT_SERVICE_SECRET=replace-with-another-64-hex-character-service-secret
PAYMENT_GATEWAY_SERVICE_ID=payment-gateway
PAYMENT_GATEWAY_SERVICE_SECRET=replace-with-a-different-64-hex-character-service-secret
AI_EXECUTION_GRANT_SECRET=replace-with-64-hex-character-grant-secret
AI_EXECUTION_GRANT_ISSUER=techit-backend
AI_EXECUTION_GRANT_AUDIENCE=techit-ai-router

# Persistent web sessions.
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_SAMESITE=lax
# Shared cookie domain when the SPA and the API are served from different hosts
# under one registrable domain (e.g. .techitnetwork.com). Required so the
# non-HttpOnly CSRF cookie is readable by the frontend. Leave unset when the SPA
# and API share an origin.
AUTH_COOKIE_DOMAIN=
# Browser sessions still return the access token in the login/refresh response
# body because ai-router and the Go messaging service authenticate with
# `Authorization: Bearer` only. Set to false once both accept the session cookie
# (WS-01c); production logs `auth_cookie_migration_incomplete` until then.
AUTH_BROWSER_BODY_TOKEN=true
REQUIRE_ADMIN_MFA=true
AUTH_CLEANUP_INTERVAL_MS=86400000

# Progressive verification evidence storage and scanning.
EVIDENCE_STORAGE_ENDPOINT=https://s3.example.com
EVIDENCE_STORAGE_BUCKET=techit-private-verification
EVIDENCE_STORAGE_REGION=eu-central-1
EVIDENCE_STORAGE_ACCESS_KEY=
EVIDENCE_STORAGE_SECRET_KEY=
EVIDENCE_MAX_BYTES=26214400
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
VERIFICATION_AUDIT_HMAC_KEY=replace-with-64-character-audit-integrity-key
REVERIFICATION_NOTIFICATION_INTERVAL_MS=86400000

# Optional organization external verification adapters. The country catalog is
# available without credentials; each configured pair enables automated checks.
# The suffix is the normalized country name, e.g. NIGERIA or UNITED_KINGDOM.
# Unconfigured countries remain usable and are routed to admin manual review.
REGISTRY_NIGERIA_URL=
REGISTRY_NIGERIA_API_KEY=
REGISTRY_UNITED_KINGDOM_URL=
REGISTRY_UNITED_KINGDOM_API_KEY=

# Proof-bound Founder/Collaborator trust projection.
TRUST_PROJECTION_URL=http://localhost:8000/internal/trust/projection
TRUST_PROJECTION_SECRET=
TRUST_PROJECTION_INTERVAL_MS=30000
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/trust/linkedin/callback

# Founder identity (KYC) + sanctions/PEP screening (WS8). FAILS CLOSED: leave
# disabled until provider selection, DPIA/data-protection approval, and covered
# regions are recorded by compliance. Raw documents are never stored — only the
# decision, an opaque provider reference, and a result hash.
# Master switches: TRUST_IDENTITY_ENABLED (founder surface) and TRUST_KYC_ENABLED
# (the compliance gate below). Both must be true AND the gate fully configured.
TRUST_IDENTITY_ENABLED=false
TRUST_KYC_ENABLED=false
# Allowlisted KYC provider: stripe_identity | persona | onfido | veriff.
TRUST_KYC_PROVIDER=
# DPIA / data-protection approval reference + the regions KYC may cover.
TRUST_DPIA_APPROVAL_REF=
TRUST_KYC_REGIONS=
TRUST_KYC_RETENTION_DAYS=365
TRUST_SANCTIONS_RESCREEN_DAYS=30
# Read-only provider credentials (platform fallback). Founders may instead store
# an encrypted key in the vault; the plaintext key is never persisted.
STRIPE_IDENTITY_SECRET_KEY=
PERSONA_API_KEY=
ONFIDO_API_TOKEN=
VERIFF_API_KEY=
SANCTIONS_IO_API_KEY=
# Identity proof lifecycle + sanctions screening policy.
TRUST_IDENTITY_PROOF_TTL_DAYS=365
TRUST_IDENTITY_SYNC_INTERVAL_MS=86400000
TRUST_IDENTITY_TIMEOUT_MS=15000
# Sanctions/PEP screening is on by default once identity is enabled; the public
# OFAC SDN list needs no credential. Providers are allow-listed; require_screening
# blocks a KYC verification until a clear screening result exists.
TRUST_IDENTITY_SCREENING_ENABLED=true
TRUST_IDENTITY_SCREENING_PROVIDERS=ofac
TRUST_IDENTITY_REQUIRE_SCREENING=false
# Off by default; enable on a single replica (or hit
# POST /trust/internal/identity/refresh from an external scheduler).
TRUST_IDENTITY_REFRESH_ENABLED=false
LINKEDIN_SCOPES=openid profile email

# WS9 continuous re-verification / decay / manual overrides. Source TTLs come
# from SYNC_INTERVALS (mirrors ai-router/trust_engine_lite.py) and each is
# overridable per source with TRUST_SYNC_INTERVAL_<SOURCE>_MS. One scheduler
# tick flips stale verified proofs/skills to `expired`, recomputes the affected
# profiles, and enqueues projection outbox rows.
# Off by default; enable on exactly one replica (or run
# POST /trust/internal/reverification/run from an external scheduler).
TRUST_REVERIFICATION_ENABLED=false
TRUST_REVERIFICATION_INTERVAL_MS=21600000
# Per-source TTL overrides (ms), e.g.:
# TRUST_SYNC_INTERVAL_GITHUB_MS=86400000
# TRUST_SYNC_INTERVAL_DEPLOYMENT_MS=43200000
# TRUST_SYNC_INTERVAL_MILESTONE_MS=15552000000
# The repository-backed projection outbox worker runs automatically (off the
# request path) when TRUST_PROJECTION_SECRET + TRUST_PROJECTION_URL are set and
# TRUST_WRITE_SOURCE=postgres; its interval reuses TRUST_PROJECTION_INTERVAL_MS.
# Manual score overrides are admin-only. A reason code from this allowlist and a
# future expiry are mandatory; delta is bounded to +/-50.
TRUST_OVERRIDE_REASON_CODES=provider_outage,verified_offline,dispute_resolution,fraud_hold,goodwill_credit,pilot_program,legal_hold

# High-risk capability MFA assertions.
MFA_ISSUER=TechIT Network
MFA_ENCRYPTION_KEY=replace-with-64-character-mfa-encryption-key
MFA_ASSERTION_SECRET=replace-with-64-character-short-lived-assertion-key

# WS-14: per-minute ceilings for the highest-sensitivity read surfaces.
FILES_REQUESTS_PER_MINUTE=120
DEAL_ROOM_REQUESTS_PER_MINUTE=120

# ---------------------------------------------------------------------------
# WS5 shipping / deployment cadence verification
# ---------------------------------------------------------------------------
# Master gate + sub-provider allow-list (default: github_actions).
TRUST_SHIPPING_ENABLED=false
TRUST_SHIPPING_PROVIDERS=github_actions
# Read-only provider credentials (founder-supplied keys are stored encrypted;
# these platform values are the fallback and reuse the same names the platform
# already uses). GITHUB_TOKEN is used for the platform fallback if
# GITHUB_ACTIONS_TOKEN is unset.
GITHUB_ACTIONS_TOKEN=
GITHUB_ACTIONS_REPO=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
RENDER_API_KEY=
RENDER_SERVICE_ID=
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
# Per-sub-provider kill switches (all default enabled once the master gate is on).
TRUST_SHIPPING_GITHUB_ACTIONS_ENABLED=true
TRUST_SHIPPING_VERCEL_ENABLED=true
TRUST_SHIPPING_RENDER_ENABLED=true
TRUST_SHIPPING_RAILWAY_ENABLED=true
TRUST_SHIPPING_CLOUDFLARE_ENABLED=true
TRUST_SHIPPING_NETLIFY_ENABLED=true
# Anti-gaming + cadence thresholds.
TRUST_SHIPPING_REQUIRE_DPIA=false
TRUST_SHIPPING_DPIA_APPROVAL_REF=
TRUST_SHIPPING_REQUIRE_DOMAIN_MATCH=false
TRUST_SHIPPING_MIN_DEPLOYS_30D=0
TRUST_SHIPPING_MAX_DEPLOYS_JUMP_RATIO=5
TRUST_SHIPPING_MAX_FRESHNESS_HOURS=72
TRUST_SHIPPING_WINDOW_DAYS=30
TRUST_SHIPPING_PROOF_TTL_DAYS=7
TRUST_SHIPPING_SYNC_INTERVAL_MS=86400000
TRUST_SHIPPING_TIMEOUT_MS=15000
TRUST_SHIPPING_REFRESH_ENABLED=false

# ---------------------------------------------------------------------------
# WS6 team / work-email / registry / HRIS verification
# ---------------------------------------------------------------------------
TRUST_TEAM_ENABLED=false
TRUST_TEAM_WORK_EMAIL_ENABLED=true
# OTP policy. A hash secret is required to store codes (falls back to
# OTP_HASH_SECRET / JWT_SECRET).
TRUST_TEAM_OTP_HASH_SECRET=
TRUST_TEAM_OTP_TTL_MINUTES=30
TRUST_TEAM_OTP_MAX_ATTEMPTS=5
TRUST_TEAM_OTP_RESEND_COOLDOWN_SECONDS=60
# Dev-only: return the code in the response instead of emailing. Never in prod.
TRUST_TEAM_OTP_DEV_MODE=false
# Company registry providers (default: opencorporates).
TRUST_TEAM_REGISTRY_PROVIDERS=opencorporates
OPENCORPORATES_API_KEY=
COMPANIES_HOUSE_API_KEY=
TRUST_TEAM_REGISTRY_OPENCORPORATES_ENABLED=true
TRUST_TEAM_REGISTRY_COMPANIES_HOUSE_ENABLED=true
# HRIS / company-profile providers (default: gusto). Aggregates only.
TRUST_TEAM_HRIS_PROVIDERS=gusto
GUSTO_API_KEY=
RIPPLING_API_KEY=
BAMBOOHR_API_KEY=
LINKEDIN_COMPANY_ACCESS_TOKEN=
TRUST_TEAM_HRIS_GUSTO_ENABLED=true
TRUST_TEAM_HRIS_RIPPLING_ENABLED=true
TRUST_TEAM_HRIS_BAMBOOHR_ENABLED=true
TRUST_TEAM_HRIS_LINKEDIN_COMPANY_ENABLED=true
# Anti-gaming + cadence thresholds.
TRUST_TEAM_REQUIRE_DPIA=false
TRUST_TEAM_DPIA_APPROVAL_REF=
TRUST_TEAM_MIN_HEADCOUNT=0
TRUST_TEAM_MAX_HEADCOUNT_JUMP_RATIO=5
TRUST_TEAM_MAX_FRESHNESS_HOURS=72
TRUST_TEAM_PROOF_TTL_DAYS=90
TRUST_TEAM_SYNC_INTERVAL_MS=86400000
TRUST_TEAM_TIMEOUT_MS=15000
TRUST_TEAM_REFRESH_ENABLED=false

# ---------------------------------------------------------------------------
# WS7 — outcomes / milestone attestation (node-local)
# ---------------------------------------------------------------------------
# Master switch. When false, milestone endpoints return trust_source_coming_soon.
TRUST_MILESTONES_ENABLED=false
# Allow-list of milestone types (default: all).
# Options: funding,contract_loi,invoice,cap_table,audit,patent,launch
TRUST_MILESTONE_TYPES=funding,contract_loi,invoice,cap_table,audit,patent,launch
# Every milestone must be backed by a scanned, hashed evidence object.
TRUST_MILESTONE_REQUIRE_EVIDENCE=true
# When true, only a third-party-attested milestone can be verified (full weight).
TRUST_MILESTONE_REQUIRE_ATTESTATION=false
# Compliance gate. No milestone can be accepted while a DPIA is required and unset.
TRUST_MILESTONE_REQUIRE_DPIA=false
TRUST_MILESTONE_DPIA_APPROVAL_REF=
# Evidence limits + lifecycle.
TRUST_MILESTONE_EVIDENCE_MAX_BYTES=26214400
TRUST_MILESTONE_MAX_EVIDENCE=10
TRUST_MILESTONE_FRESHNESS_HOURS=8760
TRUST_MILESTONE_PROOF_TTL_DAYS=365
TRUST_MILESTONE_TIMEOUT_MS=15000
# E-sign attestation providers (read-only envelope status -> third_party_attested).
DOCUSIGN_ACCESS_TOKEN=
HELLOSIGN_API_KEY=

# ---------------------------------------------------------------------------
# WS11 — trust observability + rollout
# ---------------------------------------------------------------------------
# Metrics surfaces (same snapshot):
#   GET /api/trust/admin/metrics    admin-only JSON (UI + humans)
#   GET /api/trust/internal/metrics/trust  service-auth Prometheus text (scrape)
# It combines the in-process registry (proof writes, adapter success/failure,
# expiry, anomaly rate, p95/p99 latency, projection lag) with live gauges
# (outbox depth, expired-source count, anomaly window, DB pool saturation).
# Latency reservoir size per metric (bounded; newest-forward eviction).
TRUST_METRICS_RESERVOIR=2048
# Alert thresholds are DERIVED from the signed-off target profile (see
# src/config/trustSlo.js), not guessed here. Fill these in with the real
# capacity numbers; the metrics payload reports slo.signed_off=false until then.
# Latency objective (defaults match the k6 gate: 300 / 800 ms).
TRUST_SLO_P95_MS=300
TRUST_SLO_P99_MS=800
# 5xx objective (default 0.001 = 0.1%).
TRUST_SLO_ERROR_RATE=0.001
# Peak request rate, either explicit or derived from DAU x peak factor.
# TRUST_TARGET_PEAK_RPS=600
# TRUST_TARGET_DAU=8640000
TRUST_PEAK_FACTOR=6
# Outbox-depth alert = peak_rps * TRUST_OUTBOX_MAX_LAG_SECONDS (scales with load).
TRUST_OUTBOX_MAX_LAG_SECONDS=60
# Optional explicit overrides (default: derived / 1000).
# TRUST_OUTBOX_DEPTH_ALERT=18000
TRUST_EXPIRED_SOURCE_ALERT=1000
# Minimum samples before rate-based alerts fire.
TRUST_METRICS_MIN_SAMPLES=20
# Rollout: print the per-source availability + blocking flag / missing
# credentials with `npm run trust:rollout:status`. Per-source feature flags are
# the TRUST_*_ENABLED gates documented above; canary the replicas after flipping.
# Cutover + rollback drill (includes TRUST): `npm run core:cutover:rollback-drill`.

# ---------------------------------------------------------------------------
# §5 scaling gate — whole-DB-read instrumentation + 1M-user seed (staging only)
# ---------------------------------------------------------------------------
# Service-auth for GET /internal/metrics/platform-authority (the per-replica
# request-path whole-DB-read counter scraped by the k6 gate assertion). Falls
# back to TRUST_INGEST_SECRET when unset; fails closed when neither is set.
INTERNAL_METRICS_SECRET=
# Seed tooling: `SEED_CONFIRM=1 npm run platform:db:seed-1m` writes this many
# synthetic founder profiles into platform_collection_records (batched,
# idempotent). `--dry-run` previews; `--purge` removes them. Production is
# refused unless SEED_ALLOW_PRODUCTION=true.
SEED_USER_COUNT=1000000
SEED_BATCH_SIZE=1000
SEED_COLLECTION=profiles
# §5 domain cutover: when SECURITY_EVENT_SOURCE=postgres the security-event
# audit store writes/reads platform_collection_records row-level instead of the
# whole-DB snapshot. SECURITY_EVENT_FALLBACK_SQLITE=false makes the row-level
# store authoritative (no snapshot fallback) once soaked.
SECURITY_EVENT_SOURCE=
SECURITY_EVENT_FALLBACK_SQLITE=true
# Distribution/referral (objects, shares, attributions, growth events) row-level
# store. DISTRIBUTION_FALLBACK_SQLITE=false makes it authoritative once soaked.
DISTRIBUTION_SOURCE=
DISTRIBUTION_FALLBACK_SQLITE=true
# TechIT Moments (moments, shares, referrals, events + the cross-domain evidence
# rows that generate them) row-level store. MOMENTS_FALLBACK_SQLITE=false makes it
# authoritative once soaked.
MOMENTS_SOURCE=
MOMENTS_FALLBACK_SQLITE=true
# Session context (state machine, session log, checkpoints, suggestions + the
# cross-domain evidence that derives state) row-level store.
CONTEXT_SOURCE=
CONTEXT_FALLBACK_SQLITE=true
# Support notifications: contact lookup row-level store.
SUPPORT_SOURCE=
SUPPORT_FALLBACK_SQLITE=true
# Verification (profiles/evidence/requests, trust/risk projections, manual
# reviews + audit trails, the reverification notification tick and the
# organization create/claim/membership flows) row-level store.
VERIFICATION_SOURCE=
VERIFICATION_FALLBACK_SQLITE=true
# Security posture snapshot: audit-collection presence + recent trend read/written
# row-level instead of a whole-DB snapshot.
POSTURE_SOURCE=
POSTURE_FALLBACK_SQLITE=true
# Compliance (consent records, data-subject requests, residency preferences,
# registries, subject export/erasure) row-level store.
COMPLIANCE_SOURCE=
COMPLIANCE_FALLBACK_SQLITE=true
# Registry/domain verification (org registry checks, domain challenges,
# verified domains, manual reviews) row-level store. The country registry
# catalog is derived in-process and is no longer stored.
REGISTRY_SOURCE=
REGISTRY_FALLBACK_SQLITE=true
# Workspace capability (build profiles/estimates/preview, lifecycle events, BYOK
# model connections/bindings, hackathon entries) row-level store.
WORKSPACE_CAPABILITY_SOURCE=
WORKSPACE_CAPABILITY_FALLBACK_SQLITE=true
# Workspace-team grants: FINANCE_WRITE_SOURCE=postgres already routes the grant
# read path through the scoped finance snapshot; set WORKSPACE_TEAM_WRITE_SOURCE
# to cut the grant write path over explicitly.
WORKSPACE_TEAM_WRITE_SOURCE=
# Billing maintenance job (expired reservations/grants, margin alerts). Runs
# row-level when BILLING_JOBS_SOURCE=postgres (or FINANCE_WRITE_SOURCE).
BILLING_JOBS_SOURCE=
