# Node/Express API and mounted Plugins-MCP surface.
NODE_ENV=production
PORT=3000

# Shared with ai-router, Plugins-MCP auth, and messaging-backend.
JWT_SECRET=replace-with-64-hex-character-shared-platform-secret

# Browser CORS and links generated by password reset emails.
CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com

# Durable auth/profile/notification/file metadata.
DB_DRIVER=sqlite
SQLITE_DB_PATH=/var/lib/techit/backend/techit.sqlite

# Email delivery for OTP and password reset flows.
RESEND_API_KEY=re_replace_me
FROM_EMAIL=TechIT <noreply@example.com>

# Mounted Plugins-MCP state. File store is a single-replica deployment bridge;
# keep these flags explicit until a multi-replica datastore replaces it.
MCP_DATA_FILE=/var/lib/techit/plugins-mcp.json
MCP_ALLOW_FILE_STORE=true
MCP_ALLOW_STUB_CONNECTORS=true
MCP_APPROVAL_TTL_MS=900000

# GitHub OAuth (register at https://github.com/settings/developers)
# Test credentials work in local mode — replace for production.
GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback

# Video CDN (use test URL locally, replace with Cloudflare/S3 CDN in production)
VIDEO_CDN_BASE=https://test-cdn.techit.dev/videos

# Admin dashboard initial super admin (auto-created on first login attempt)
ADMIN_SUPER_EMAIL=superadmin@techit.dev
ADMIN_SUPER_PASSWORD=TechIT-Super-2026!

# Backend-owned AI usage reservation and settlement contract.
AI_ROUTER_SETTLEMENT_SECRET=replace-with-64-hex-character-service-secret
AI_ROUTER_SERVICE_ID=ai-router
AI_ROUTER_SETTLEMENT_MAX_SKEW_SECONDS=300
AI_USAGE_GRANT_SERVICE_ID=platform-backend
AI_USAGE_GRANT_SERVICE_SECRET=replace-with-another-64-hex-character-service-secret
AI_EXECUTION_GRANT_SECRET=replace-with-64-hex-character-grant-secret
AI_EXECUTION_GRANT_ISSUER=techit-backend
AI_EXECUTION_GRANT_AUDIENCE=techit-ai-router
