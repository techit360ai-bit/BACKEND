# Node/Express API and mounted Plugins-MCP surface.
NODE_ENV=production
PORT=3000

# Shared with ai-router, Plugins-MCP auth, and messaging-backend.
JWT_SECRET=replace-with-64-hex-character-shared-platform-secret
JWT_ISSUER=techit-backend
JWT_AUDIENCE=techit-platform
OTP_HASH_SECRET=replace-with-a-separate-64-character-otp-hmac-secret

# Browser CORS and links generated by password reset emails.
CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
TRUST_PROXY_HOPS=1

# Durable auth/profile/notification/file metadata.
DB_DRIVER=sqlite
SQLITE_DB_PATH=/var/lib/techit/backend/techit.sqlite
# Use single-node for SQLite. Multi-replica requires completing the core
# PostgreSQL state migration; Redis is mandatory for shared coordination.
SCALE_PROFILE=single-node
REQUIRE_SHARED_STATE=false
GLOBAL_RATE_LIMIT_REDIS=true
GLOBAL_API_REQUESTS_PER_MINUTE=600
GLOBAL_AUTH_REQUESTS_PER_MINUTE=600
AI_ROUTER_MAX_IN_FLIGHT=64
AI_ROUTER_MAX_QUEUE=256
TRUST_DATABASE_URL=postgresql://trust_app:replace@postgres.example:5432/techit_trust?sslmode=require
IDENTITY_DATABASE_URL=postgresql://core_app:replace@postgres.example:5432/techit_core?sslmode=require
IDENTITY_DB_POOL_SIZE=5
IDENTITY_PROJECTION_INTERVAL_MS=30000
IDENTITY_SHADOW_READS=false
IDENTITY_SHADOW_READ_REQUIRED=false
MIGRATION_OUTBOX_BATCH_SIZE=100
WORKSPACE_DATABASE_URL=postgresql://core_app:replace@postgres.example:5432/techit_core?sslmode=require
WORKSPACE_DB_POOL_SIZE=5
WORKSPACE_PROJECTION_INTERVAL_MS=30000
TRUST_DB_SSL_REJECT_UNAUTHORIZED=true
TRUST_DB_POOL_SIZE=5
TRUST_PROJECTION_INTERVAL_MS=30000

# Universal Discovery normalized projection, vector search, cache and worker.
DISCOVERY_DATABASE_URL=postgresql://discovery_app:replace@postgres.example:5432/techit_discovery?sslmode=require
DISCOVERY_REDIS_URL=rediss://redis.example.com:6379
DISCOVERY_DB_POOL_SIZE=10
DISCOVERY_CACHE_TTL_SECONDS=300
DISCOVERY_FULL_REFRESH_MS=900000

# Email delivery for OTP and password reset flows.
RESEND_API_KEY=re_replace_me
WHATSAPP_NOTIFICATION_URL=
WHATSAPP_NOTIFICATION_SECRET=
FROM_EMAIL=TechIT <noreply@example.com>

# Plugins-MCP production storage and encrypted connector credentials.
MCP_ENABLED=true
MCP_STORE=postgres
MCP_DATABASE_URL=postgresql://mcp_app:replace@postgres.example:5432/techit_mcp?sslmode=require
MCP_DATABASE_SSL=true
MCP_DATABASE_SSL_REJECT_UNAUTHORIZED=true
MCP_SECRET_KEY=replace_with_base64_encoded_32_byte_key
MCP_SECRET_KEY_PREVIOUS=
MCP_ENABLED_CONNECTORS=github,notion,figma,web3
MCP_DATA_FILE=/tmp/techit/plugins-mcp.json
MCP_ALLOW_FILE_STORE=false
MCP_ALLOW_STUB_CONNECTORS=false
MCP_SEED_DEMO_ACTIVITY=false
MCP_APPROVAL_TTL_MS=900000
GITHUB_CONNECTOR_MODE=real
MCP_GITHUB_TOKEN=replace-with-production-github-app-token
NOTION_CONNECTOR_MODE=real
NOTION_TOKEN=replace-with-production-notion-token
FIGMA_CONNECTOR_MODE=real
FIGMA_TOKEN=replace-with-production-figma-token
WEB3_CONNECTOR_MODE=real
WEB3_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SIWE_EXPECTED_DOMAIN=app.example.com
SIWE_EXPECTED_URI=https://app.example.com
SIWE_EXPECTED_CHAIN_ID=11155111
SIWE_MAX_AGE_MS=600000

# GitHub OAuth (register at https://github.com/settings/developers)
# Test credentials work in local mode — replace for production.
GITHUB_CLIENT_ID=replace-with-production-github-client-id
GITHUB_CLIENT_SECRET=replace-with-production-github-client-secret
GITHUB_REDIRECT_URI=https://api.example.com/api/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-character-encryption-key

# Video CDN (use test URL locally, replace with Cloudflare/S3 CDN in production)
VIDEO_CDN_BASE=https://test-cdn.techit.dev/videos

# Admin dashboard initial super admin (auto-created on first login attempt)
# Optional one-time bootstrap. Do not use defaults; remove these after the
# first super-admin is created and rotate the password immediately.
ADMIN_SUPER_EMAIL=
ADMIN_SUPER_PASSWORD=

# Backend-owned AI usage reservation and settlement contract.
AI_ROUTER_SETTLEMENT_SECRET=replace-with-64-hex-character-service-secret
ADMIN_AI_ROUTER_TELEMETRY_SECRET=replace-with-a-dedicated-64-character-admin-telemetry-secret
ADMIN_AI_ROUTER_TELEMETRY_SERVICE_ID=platform-backend
AI_ROUTER_SERVICE_ID=ai-router
AI_ROUTER_SETTLEMENT_MAX_SKEW_SECONDS=300
AI_USAGE_GRANT_SERVICE_ID=platform-backend
AI_USAGE_GRANT_SERVICE_SECRET=replace-with-another-64-hex-character-service-secret
AI_EXECUTION_GRANT_SECRET=replace-with-64-hex-character-grant-secret
AI_EXECUTION_GRANT_ISSUER=techit-backend
AI_EXECUTION_GRANT_AUDIENCE=techit-ai-router

# Persistent web sessions.
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_SAMESITE=lax
AUTH_CLEANUP_INTERVAL_MS=86400000

# Progressive verification evidence storage and scanning.
EVIDENCE_STORAGE_ENDPOINT=https://s3.example.com
EVIDENCE_STORAGE_BUCKET=techit-private-verification
EVIDENCE_STORAGE_REGION=eu-central-1
EVIDENCE_STORAGE_ACCESS_KEY=
EVIDENCE_STORAGE_SECRET_KEY=
EVIDENCE_MAX_BYTES=26214400
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
VERIFICATION_AUDIT_HMAC_KEY=replace-with-64-character-audit-integrity-key
REVERIFICATION_NOTIFICATION_INTERVAL_MS=86400000

# High-risk capability MFA assertions.
MFA_ISSUER=TechIT Network
MFA_ENCRYPTION_KEY=replace-with-64-character-mfa-encryption-key
MFA_ASSERTION_SECRET=replace-with-64-character-short-lived-assertion-key
