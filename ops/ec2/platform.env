# =============================================================================
# TechIT platform — production env template for the AWS EC2 host.
#
# This file is COMMITTED and must never contain a secret. It is applied to
# `backend/.env` on the box by ops/ec2/sync-env.mjs during the EC2 deploy.
#
# Precedence at apply time:
#   1. values below (safe defaults for the final PostgreSQL architecture)
#   2. non-empty process-env overrides for any key (secrets injected by CI)
#   3. DB_DRIVER drives every *_SOURCE / *_FALLBACK_SQLITE switch, so the
#      sqlite -> postgres cutover is a single flag (GitHub repo variable
#      PLATFORM_DB_DRIVER) and can never half-flip.
#
# Injected from GitHub Actions secrets (leave blank here):
#   PLATFORM_DATABASE_URL  REDIS_URL  MCP_SECRET_KEY
# =============================================================================

# ── Core runtime ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
SCALE_PROFILE=single-node
REQUIRE_SHARED_STATE=false
TRUST_PROXY_HOPS=1
CORS_ORIGINS=https://beta.techitnetwork.com
FRONTEND_URL=https://beta.techitnetwork.com
# Cookie scope. The SPA (https://beta.techitnetwork.com) and the API
# (https://backend.techitnetwork.com) are sibling subdomains, so the readable
# double-submit CSRF cookie must be scoped to the registrable domain or the SPA
# cannot read it from `document.cookie` and every cookie-authenticated POST
# 403s (csrf_token_invalid). The HttpOnly access/refresh cookies stay host-only.
AUTH_CSRF_COOKIE_DOMAIN=.techitnetwork.com

# ── Platform request authority ───────────────────────────────────────────────
# DB_DRIVER is the single switch. Post-cutover it is `postgres`; sync-env.mjs
# derives PLATFORM_REQUEST_AUTHORITY and every domain read/write source from it.
DB_DRIVER=postgres
# Retained legacy store for the one-time backfill/verification only.
LEGACY_DB_DRIVER=sqlite
# The legacy store this box actually ran on (the generic runbook path
# /var/lib/techit/backend/techit.sqlite does not exist here and is not
# writable by the deploy user).
SQLITE_DB_PATH=/home/ubuntu/backend-data/techit.db

# ── PostgreSQL (AWS RDS) ─────────────────────────────────────────────────────
# The canonical URL is injected from the PLATFORM_DATABASE_URL secret; every
# per-domain *_DATABASE_URL and MCP_DATABASE_URL is derived from it, so the
# whole platform shares one RDS database (table prefixes keep domains apart).
PLATFORM_DATABASE_URL=
DATABASE_URL=
MCP_DATABASE_URL=
IDENTITY_DATABASE_URL=
WORKSPACE_DATABASE_URL=
CONTENT_DATABASE_URL=
INVESTOR_DATABASE_URL=
ORGANIZATION_DATABASE_URL=
FINANCE_DATABASE_URL=
TRUST_DATABASE_URL=
DISCOVERY_DATABASE_URL=
# Connection budget. RDS allows max_connections=81 and the app opens a separate
# pg.Pool per domain. The code defaults (10 for platform/discovery, 5 for each
# other pool) sum to ~85 and exhaust the server, so requests and the
# identity-security sync fail with "remaining connection slots are reserved for
# roles with privileges of the rds_reserved role" - which silently breaks
# onboarding writes (role activation / profile update). Cap each pool so the
# worst-case total stays well under the server limit.
PLATFORM_DB_POOL_SIZE=6
IDENTITY_READ_POOL_SIZE=2
IDENTITY_WRITE_POOL_SIZE=2
IDENTITY_DB_POOL_SIZE=2
CONTENT_READ_POOL_SIZE=2
CONTENT_WRITE_POOL_SIZE=2
CONTENT_DB_POOL_SIZE=2
FINANCE_READ_POOL_SIZE=2
FINANCE_DB_POOL_SIZE=2
ORGANIZATION_DB_POOL_SIZE=2
INVESTOR_DB_POOL_SIZE=2
WORKSPACE_READ_POOL_SIZE=2
WORKSPACE_DB_POOL_SIZE=2
DISCOVERY_DB_POOL_SIZE=2
TRUST_DB_POOL_SIZE=2
PLATFORM_DB_CONNECTION_TIMEOUT_MS=5000
# RDS presents the AWS CA, which is not in Node's default trust store. The read
# repositories implement sslmode=require (encrypted transport, no CA pin) when
# this is `false`. Hardening to verify-full is tracked in the runbook.
PLATFORM_DB_SSL_REJECT_UNAUTHORIZED=false
TRUST_DB_SSL_REJECT_UNAUTHORIZED=false

# ── Shared Redis (ElastiCache) ───────────────────────────────────────────────
REDIS_URL=
GLOBAL_RATE_LIMIT_REDIS=true
GLOBAL_API_REQUESTS_PER_MINUTE=600
GLOBAL_AUTH_REQUESTS_PER_MINUTE=600

# ── Domain read/write sources (post-cutover baseline; flipped by DB_DRIVER) ──
IDENTITY_READ_SOURCE=postgres
IDENTITY_WRITE_SOURCE=postgres
IDENTITY_READ_FALLBACK_SQLITE=false
IDENTITY_WRITE_FALLBACK_SQLITE=false
WORKSPACE_READ_SOURCE=postgres
WORKSPACE_WRITE_SOURCE=postgres
WORKSPACE_READ_FALLBACK_SQLITE=false
WORKSPACE_WRITE_FALLBACK_SQLITE=false
WORKSPACE_CODE_SOURCE=postgres
WORKSPACE_CODE_FALLBACK_SQLITE=false
CONTENT_READ_SOURCE=postgres
CONTENT_WRITE_SOURCE=postgres
CONTENT_READ_FALLBACK_SQLITE=false
CONTENT_WRITE_FALLBACK_SQLITE=false
INVESTOR_READ_SOURCE=postgres
INVESTOR_WRITE_SOURCE=postgres
INVESTOR_READ_FALLBACK_SQLITE=false
INVESTOR_WRITE_FALLBACK_SQLITE=false
ORGANIZATION_READ_SOURCE=postgres
ORGANIZATION_WRITE_SOURCE=postgres
ORGANIZATION_READ_FALLBACK_SQLITE=false
ORGANIZATION_WRITE_FALLBACK_SQLITE=false
FINANCE_READ_SOURCE=postgres
FINANCE_WRITE_SOURCE=postgres
FINANCE_READ_FALLBACK_SQLITE=false
FINANCE_WRITE_FALLBACK_SQLITE=false
INTELLIGENCE_SOURCE=postgres
INTELLIGENCE_READ_SOURCE=postgres
INTELLIGENCE_WRITE_SOURCE=postgres
INTELLIGENCE_FALLBACK_SQLITE=false
OPERATIONAL_SOURCE=postgres
OPERATIONAL_READ_SOURCE=postgres
OPERATIONAL_WRITE_SOURCE=postgres
OPERATIONAL_FALLBACK_SQLITE=false

# ── Plugins-MCP ──────────────────────────────────────────────────────────────
# MCP store is PostgreSQL. Tables are `mcp_`-prefixed and live in the same RDS
# database as the rest of the platform (no separate database needed).
MCP_ENABLED=true
MCP_STORE=postgres
MCP_DATABASE_SSL=true
MCP_DATABASE_SSL_REJECT_UNAUTHORIZED=false
MCP_SECRET_KEY=
MCP_SECRET_KEY_PREVIOUS=
MCP_DATA_FILE=/tmp/techit/plugins-mcp.json
MCP_ALLOW_FILE_STORE=false
MCP_ALLOW_STUB_CONNECTORS=false
MCP_SEED_DEMO_ACTIVITY=false
MCP_APPROVAL_TTL_MS=900000
# Credentials are NOT read from env in production (workspace vault is canonical,
# ADR-3). Modes are required for every enabled connector.
MCP_ENABLED_CONNECTORS=github,notion,figma,web3,ai
GITHUB_CONNECTOR_MODE=real
NOTION_CONNECTOR_MODE=real
FIGMA_CONNECTOR_MODE=real
WEB3_CONNECTOR_MODE=real
AI_HARNESS_CONNECTOR_MODE=real
WEB3_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AI_ROUTER_URL=https://api.techitnetwork.com
